{
  "name": "celestial",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "description": "Weather drawn as a slice of the real atmosphere over a place.",
  "scripts": {
    "dev": "vite --port 4180",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@fontsource/chivo": "^5.3.0",
    "@fontsource/chivo-mono": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
